# =========================================================
# CyberShield ONE - Environment Variables (example)
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to version control.
# =========================================================

# --- Database ---
DATABASE_PATH=database/cybershield.db

# --- Email Breach Check (optional) ---
# If left empty, the Breach Checker runs in DEMO MODE (clearly labeled).
# Example provider: HaveIBeenPwned (requires a paid API key as of 2024).
HIBP_API_KEY=

# --- AI Security Assistant (optional) ---
# If left empty, the assistant falls back to a rule-based engine.
LLM_API_KEY=
LLM_API_PROVIDER=none

# --- App Security ---
# Random secret used for session-related hashing/salting utilities.
APP_SECRET_KEY=change_this_to_a_random_secret_string

# --- Misc ---
APP_ENV=development
